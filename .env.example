# Project Meridian — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── LLM (required for live explanations) ──────────────────────────────────────
# If not set, the system automatically falls back to deterministic template
# explanations. The pipeline never blocks on a missing key.
ANTHROPIC_API_KEY=your_key_here

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Simulation ─────────────────────────────────────────────────────────────────
SIMULATION_BATCH_SIZE=5000
SIMULATION_RANDOM_SEED=42

# ── Audit DB ───────────────────────────────────────────────────────────────────
AUDIT_DB_PATH=./audit.db
